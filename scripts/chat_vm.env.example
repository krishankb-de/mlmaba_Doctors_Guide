# Copy to scripts/chat_vm.env, which git ignores, and put your own values in. Read by scripts/vm_remote.sh.
# Nothing here is a secret, but the host alias and the path belong to you, not to the repository.
#
# VM_HOST: the ssh host name or alias of the VM, as ~/.ssh/config knows it.
# VM_REPO: the absolute path where `vm_remote.sh sync` writes this repository on the VM.
# VM_SERVICE: the systemd unit that runs the server (lower-case letters, digits and "-"). Leave it out for cxr-chat.
VM_HOST="<vm-alias>"
VM_REPO="/home/<vm-user>/mlmaba_doctors_guide"
VM_SERVICE=cxr-chat

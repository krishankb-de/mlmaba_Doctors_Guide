# Copy to scripts/chat_cluster.env, which git ignores, and put your own values in. Read by scripts/chat_remote.sh (every key) and by
# app/tunnel/tunnel.sh (CLUSTER_HOST, CLUSTER_USER, CLUSTER_KNOWN_HOSTS); give CLUSTER_HOST to scripts/chat_requeue_drill.py as --login.
#
# CLUSTER_HOST: the ssh host name or alias of the cluster's login node. CLUSTER_USER: your user on the cluster.
# CLUSTER_REPO: where `chat_remote.sh sync` writes this repository on the cluster.
# MAIN_REPO: the checkout whose outputs/ holds the trained checkpoints; it is never a sync target.
# CLUSTER_KNOWN_HOSTS: the file the tunnel keeps the compute nodes' host keys in (~/ is your home on this machine).
CLUSTER_HOST=login-node-alias
CLUSTER_USER=cluster-user
CLUSTER_REPO=/sc/home/cluster-user/mlmaba_doctors_guide
MAIN_REPO=/sc/home/cluster-user/hybrid_mamba_xlstm
SCRATCH_ROOT=/sc/scratch/cluster-user/hybrid_xmamba_h100
CLUSTER_KNOWN_HOSTS=~/.ssh/known_hosts_cluster_nodes
#
# The SLURM site settings. The job wrappers in scripts/ carry the placeholders @SLURM_PARTITION@, @SLURM_ACCOUNT@, @SLURM_QOS@,
# @SLURM_EXCLUDE@ and @SLURM_EXCLUDE_ARCH@; `chat_remote.sh sync` fills them in on the cluster copy, so a wrapper submitted there, by
# `chat_remote.sh submit` or by hand with sbatch, carries these values. SLURM_EXCLUDE: the nodes no job may use (a comma-separated list,
# which must hold every node of SLURM_EXCLUDE_ARCH); SLURM_EXCLUDE_ARCH: the nodes whose CPU architecture cannot run the x86 virtual environment.
SLURM_PARTITION=batch-partition
SLURM_ACCOUNT=account-name
SLURM_QOS=qos-name
SLURM_EXCLUDE=node01,node02
SLURM_EXCLUDE_ARCH=node01
